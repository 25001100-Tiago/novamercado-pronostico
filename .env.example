# Copiar a .env y ajustar. Nunca versionar .env.

# PostgreSQL (servicio de datos del pronóstico)
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=novamercado
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://novamercado:cambiar_esta_clave@localhost:5432/novamercado

# Datos crudos (catálogos e histórico)
NOVAMERCADO_DATA_DIR=data/raw

# MLflow (registro de modelos)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODELO_NOMBRE=novamercado-pronostico
MLFLOW_ALIAS_PRODUCCION=produccion

# API
API_HOST=0.0.0.0
API_PORT=8000

# Airflow
AIRFLOW_UID=50000
